# =====================================================================
# Copy to .env.local for local development.
# On Vercel, set these under Settings -> Environment Variables.
# See README.md for where each value comes from.
# =====================================================================

# --- Database (Supabase) ---------------------------------------------
# Transaction pooler, port 6543. Serverless needs the pooler; the direct
# 5432 connection runs out of Postgres slots under real traffic.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Direct connection, port 5432. Only needed to run migrations
# (drizzle-kit cannot use the transaction pooler).
DIRECT_DATABASE_URL=

# Connections per serverless instance. Optional, defaults to 3.
DATABASE_POOL_MAX=3

# --- Admin auth (Supabase) -------------------------------------------
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated allowlist. THIS is the access control for /admin — a
# valid Supabase user is not an admin unless listed here.
ADMIN_EMAILS=ishant@spectrerex.com,admin@spectrerex.com
